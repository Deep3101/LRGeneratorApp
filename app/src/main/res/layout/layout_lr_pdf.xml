<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="595dp"
    android:layout_height="842dp"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="20dp">

    <TextView android:id="@+id/pdf_copy_name" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="CONSIGNEE COPY"
        android:gravity="right" android:textStyle="bold" />

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Shree Sai Roadways" android:textSize="24sp"
        android:textStyle="bold" android:gravity="center" android:textColor="#000000"/>

    <View android:layout_width="match_parent" android:layout_height="2dp"
        android:background="#000000" android:layout_marginVertical="10dp"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/pdf_truck_no" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="Truck No: " android:textStyle="bold"/>
        <TextView android:id="@+id/pdf_date" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="Date: " android:gravity="end"/>
    </LinearLayout>

    <TextView android:id="@+id/pdf_consignor" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="Consignor: " android:paddingVertical="5dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#000000"
        android:padding="1dp"
        android:layout_marginTop="10dp">

        <TextView android:layout_width="70dp" android:layout_height="wrap_content" android:text="Packages" android:background="#FFFFFF" android:gravity="center" android:padding="5dp" android:textStyle="bold" android:textSize="10sp"/>
        <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#000000"/>
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="DESCRIPTION (Said to Contain)" android:background="#FFFFFF" android:gravity="center" android:padding="5dp" android:textStyle="bold" android:textSize="10sp"/>
        <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#000000"/>
        <TextView android:layout_width="100dp" android:layout_height="wrap_content" android:text="WEIGHT" android:background="#FFFFFF" android:gravity="center" android:padding="5dp" android:textStyle="bold" android:textSize="10sp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:orientation="horizontal"
        android:background="#000000"
        android:paddingLeft="1dp"
        android:paddingRight="1dp"
        android:paddingBottom="1dp">

        <TextView android:id="@+id/res_pkgs" android:layout_width="70dp" android:layout_height="match_parent" android:background="#FFFFFF" android:gravity="center_horizontal" android:padding="5dp" />
        <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#000000"/>
        <TextView android:id="@+id/res_desc" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:background="#FFFFFF" android:padding="5dp" />
        <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#000000"/>
        <TextView android:id="@+id/res_weight" android:layout_width="100dp" android:layout_height="match_parent" android:background="#FFFFFF" android:gravity="center_horizontal" android:padding="5dp" />
    </LinearLayout>

</LinearLayout>